{
  "name": "comercio-ejemplo-tienda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "test": "node --test test/*.test.ts",
    "tipos": "wrangler types && astro check",
    "db:local": "wrangler d1 migrations apply comercio-ejemplo-tienda-demo --local",
    "db:remota": "wrangler d1 migrations apply comercio-ejemplo-tienda-demo --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "astro": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
