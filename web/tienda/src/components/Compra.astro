---
// Pantalla de pago (tienda y sitio mayorista), aparte del carrito: pasos arriba, «Tus datos»,
// «Retiro» y «Pago» en bloques con su color, y el resumen del pedido al costado (abajo en el
// celular, con el total y el botón fijos). El resumen lo arma scripts/carrito.ts.
import { local } from "../data/catalogo";
import type { Cliente } from "../servidor/clientes";
const { cliente, sitekey } = Astro.props as { cliente: Cliente | null; sitekey: string };
---
<ol class="pasos-compra" aria-label="Pasos">
  <li class="hecho"><a href="/carrito">Carrito</a></li>
  <li class="actual" aria-current="step">Datos y pago</li>
  <li>Listo</li>
</ol>
<form class="compra-pag" data-compra novalidate>
  <div class="compra-bloques">
    <section class="bloque">
      <h2><span class="num">1</span>Tus datos</h2>
      <div class="campos">
        <label class="campo"><span>Nombre y apellido</span>
          <input name="nombre" placeholder="Como figura en tu documento" autocomplete="name" required minlength="2" maxlength="120" value={cliente?.nombre ?? ""}></label>
        <label class="campo"><span>Mail</span>
          <input name="email" placeholder="tu@mail.com" type="email" autocomplete="email" required maxlength="160" value={cliente?.email ?? ""} readonly={!!cliente}>
          <small>Te mandamos ahí el comprobante y el aviso de que está listo.</small></label>
        <label class="campo"><span>Teléfono <i>(opcional)</i></span>
          <input name="telefono" type="tel" placeholder="Por si hay que avisarte algo" autocomplete="tel" maxlength="30" value={cliente?.telefono ?? ""}></label>
      </div>
      {!cliente && Astro.locals.sitio !== "mayorista" && <p class="nota-demo">¿Tenés cuenta? <a href="/cuenta?v=/compra">Ingresá</a> y tus datos se completan solos.</p>}
    </section>
    <section class="bloque">
      <h2><span class="num">2</span>Retiro</h2>
      <div class="opcion elegida">
        <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10l9-6 9 6v10H3z"/><path d="M9 20v-6h6v6"/></svg></span>
        <div><b>Retiro en el local · sin cargo</b><span>{local.direccion}, {local.ciudad}. Te avisamos por mail cuando esté listo.</span></div>
      </div>
      <p class="nota-demo">Envíos a domicilio: muy pronto.</p>
    </section>
    <section class="bloque">
      <h2><span class="num">3</span>Pago</h2>
      <div class="opcion elegida">
        <span class="ico mp" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span>
        <div><b>Mercado Pago</b><span>Tarjeta de débito o crédito, dinero en cuenta o efectivo. Pagás en Mercado Pago y volvés acá.</span></div>
      </div>
      <div class="cf-turnstile" data-sitekey={sitekey} data-language="es"></div>
    </section>
  </div>
  <aside class="compra-res" aria-label="Tu pedido">
    <h2>Tu pedido</h2>
    <ul class="mini" data-mini></ul>
    <div class="fila"><span data-unidades>0 artículos</span><span data-subtotal>$ 0</span></div>
    <div class="fila" hidden={Astro.locals.sitio === "mayorista"}><span>Ahorro en ofertas</span><span data-ahorro>$ 0</span></div>
    <div class="fila"><span>Retiro</span><span>Sin cargo</span></div>
    <div class="fila total"><span>Total</span><span data-total>$ 0</span></div>
    <p class="aviso" data-error-compra hidden role="alert"></p>
    <button class="btn pagar" type="submit" data-pagar>Pagar <span data-total-boton></span></button>
    <p class="seguro"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Pago protegido por Mercado Pago. Precios con IVA incluido.</p>
  </aside>
</form>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
