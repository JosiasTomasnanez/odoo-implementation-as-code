---
// Todas las categorías (en el celular es la pestaña «Categorías»).
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
import { rubros, iconoDe } from "../servidor/consultas";
const lista = await rubros(env.DB);
Astro.response.headers.set("Cache-Control", "private, max-age=60");
---
<Base titulo="Categorías" actual="categorias">
  <section class="sec">
    <div class="sec-tit"><h1 class="h-disp">Categorías</h1></div>
    <div class="rubros-grilla">
      {lista.map((c) => (
        <a class="rubro" href={`/categoria/${c.slug}/`}>
          <span class="ic"><Icono nombre={iconoDe(c.nombre)} /></span>
          <span><b>{c.nombre}</b><small>{c.productos} {c.productos === 1 ? "producto" : "productos"}</small></span>
          {c.max_descuento > 0 && <span class="hasta-off">Hasta {c.max_descuento}% OFF</span>}
        </a>
      ))}
    </div>
  </section>
</Base>
