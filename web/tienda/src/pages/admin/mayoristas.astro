---
// Mayoristas: aprobar o rechazar los pedidos de cuenta, elegir su lista y cambiarla después. Al
// aprobar, el conector crea (o encuentra por CUIT) su contacto en Odoo con esa lista de precios.
import { env } from "cloudflare:workers";
import Base from "../../layouts/BaseAdmin.astro";
import { miembroActual, puede } from "../../servidor/equipo";
import { CAMPOS, type Cambio } from "../../servidor/cambios";
const yo = await miembroActual(env.DB, Astro.request);
if (!yo) return Astro.redirect("/admin/ingresar", 303);
if (!puede(yo, "mayoristas")) return Astro.redirect("/admin", 303);
const ver = ["aprobado", "rechazado"].includes(Astro.url.searchParams.get("ver") ?? "") ? Astro.url.searchParams.get("ver")! : "pendiente";
const ok = Astro.url.searchParams.get("ok");
// Buscar por nombre, CUIT o mail (sin comodines del usuario)
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 60);
const como = `%${q.replace(/[%_\\]/g, "")}%`;
type C = { id: string; email: string; nombre: string | null; telefono: string | null; cuit: string | null; razon_social: string | null; lista_id: number | null;
  pedido_alta: string | null; condicion_iva: string | null; actividad: string | null; direccion: string | null; localidad: string | null; contacto: string | null; aprobado: string | null; aprobado_por: string | null; nota: string | null; cambios_sin_ver: number; odoo_partner_id: number | null; odoo_pendiente: number; odoo_error: string | null; pedidos: number };
const clientes = (await env.DB.prepare(`SELECT c.id, c.email, c.nombre, c.telefono, c.cuit, c.razon_social, c.lista_id, c.pedido_alta, c.condicion_iva, c.actividad, c.direccion, c.localidad, c.contacto, c.aprobado, c.aprobado_por,
    c.nota, c.cambios_sin_ver, c.odoo_partner_id, c.odoo_pendiente, c.odoo_error, (SELECT COUNT(*) FROM pedidos p WHERE p.cliente_id = c.id AND p.sitio = 'mayorista' AND p.pagado IS NOT NULL) AS pedidos
    FROM clientes c WHERE c.mayorista = ? AND (? = '' OR c.razon_social LIKE ? OR c.cuit LIKE ? OR c.email LIKE ?)
    ORDER BY c.cambios_sin_ver DESC, COALESCE(c.pedido_alta, c.creado) DESC LIMIT 300`).bind(ver, q, como, como.replace(/-/g, ""), como).all<C>()).results;
// Lo que cada cliente cambió de sus datos (lo más nuevo primero)
const cambios = clientes.length ? (await env.DB.prepare(`SELECT cliente_id, cuando, campo, antes, despues FROM cambios_cliente
    WHERE cliente_id IN (SELECT id FROM clientes WHERE mayorista = ?) ORDER BY cuando DESC LIMIT 600`).bind(ver).all<Cambio>()).results : [];
const listas = (await env.DB.prepare("SELECT id_odoo, nombre FROM listas_precios WHERE publica = 0 ORDER BY nombre").all<{ id_odoo: number; nombre: string }>()).results;
const conteo = Object.fromEntries((await env.DB.prepare("SELECT mayorista, COUNT(*) AS n FROM clientes WHERE mayorista IS NOT NULL GROUP BY mayorista").all<{ mayorista: string; n: number }>()).results.map((r) => [r.mayorista, r.n]));
const sinVer = (await env.DB.prepare("SELECT COUNT(*) AS n FROM clientes WHERE mayorista = 'aprobado' AND cambios_sin_ver = 1").first<{ n: number }>())?.n ?? 0;
const porDefecto = listas.find((l) => /mayorista/i.test(l.nombre))?.id_odoo ?? listas[0]?.id_odoo;
const IVA: Record<string, string> = { ri: "Responsable inscripto", monotributo: "Monotributo", exento: "Exento" };
const cuit = (c: string | null) => c ? c.replace(/^(\d{2})(\d{8})(\d)$/, "$1-$2-$3") : "-";
const fecha = (t: string | null) => t ? new Date(t).toLocaleString("es-AR", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "America/Argentina/Cordoba" }) : "";
const nombreLista = (id: number | null) => listas.find((l) => l.id_odoo === id)?.nombre ?? (id ? `Lista ${id}` : "-");
---
<Base titulo="Mayoristas" actual="mayoristas" miembro={yo}>
  <h1 class="h-disp">Mayoristas</h1>
  <p class="adm-sub">Quien pide cuenta en el sitio mayorista queda acá. Al aprobar elegís su lista de precios; en Odoo se crea su contacto (o se usa el que ya tenga ese CUIT) con esa lista.</p>
  {ok && <p class="adm-ok" role="status">{({ aprobado: "Aprobado. Le avisamos por mail.", rechazado: "Rechazado.", lista: "Lista cambiada.", visto: "Marcado como revisado.", baja: "Dado de baja.", reabierto: "Volvió a pendientes." } as Record<string, string>)[ok] ?? "Listo."}</p>}
  <nav class="adm-filtro" aria-label="Estado">
    <a href="/admin/mayoristas" aria-current={ver === "pendiente" ? "page" : undefined}>Pendientes <b>{conteo.pendiente ?? 0}</b></a>
    <a href="/admin/mayoristas?ver=aprobado" aria-current={ver === "aprobado" ? "page" : undefined}>Aprobados <b>{conteo.aprobado ?? 0}</b></a>
    <a href="/admin/mayoristas?ver=rechazado" aria-current={ver === "rechazado" ? "page" : undefined}>Rechazados / bajas <b>{conteo.rechazado ?? 0}</b></a>
  </nav>
  <form class="adm-busca" method="get" role="search">
    {ver !== "pendiente" && <input type="hidden" name="ver" value={ver}>}
    <input name="q" type="search" value={q} placeholder="Buscar por nombre, CUIT o mail" aria-label="Buscar mayorista">
    <button class="btn sec2" type="submit">Buscar</button>
    {q && <a href={`/admin/mayoristas${ver !== "pendiente" ? `?ver=${ver}` : ""}`}>Quitar</a>}
  </form>
  {sinVer > 0 && ver !== "aprobado" && <p class="aviso">{sinVer === 1 ? "Un mayorista aprobado cambió" : `${sinVer} mayoristas aprobados cambiaron`} sus datos. <a href="/admin/mayoristas?ver=aprobado">Verlos</a></p>}
  {listas.length === 0 && <p class="aviso">Todavía no hay listas mayoristas sincronizadas con la tienda. Creá una en «Listas» o marcá «Sincronizar con la tienda» en una lista de Odoo.</p>}
  {clientes.length === 0 && <p class="vacio">Nada por acá.</p>}
  <div class="adm-lista">
    {clientes.map((c) => (
      <article class="adm-ficha">
        <header>
          <div><b>{c.razon_social ?? c.email}</b><span class="cod">CUIT {cuit(c.cuit)}</span></div>
          {ver === "pendiente" && <span class="estado pend">Pidió el {fecha(c.pedido_alta)}</span>}
          {ver === "aprobado" && <span class="estado ok">{nombreLista(c.lista_id)}</span>}
          {ver === "rechazado" && <span class="estado no">Rechazado</span>}
        </header>
        <dl>
          <div><dt>IVA</dt><dd>{IVA[c.condicion_iva ?? ""] ?? "-"}</dd></div>
          <div><dt>Actividad</dt><dd>{c.actividad ?? "-"}</dd></div>
          <div><dt>Contacto</dt><dd>{c.contacto ?? c.nombre ?? "-"}</dd></div>
          <div><dt>Teléfono</dt><dd>{c.telefono ? <a href={`tel:${c.telefono.replace(/[^0-9+]/g, "")}`}>{c.telefono}</a> : "-"}</dd></div>
          <div><dt>Mail</dt><dd><a href={`mailto:${c.email}`}>{c.email}</a></dd></div>
          <div><dt>Dirección</dt><dd>{[c.direccion, c.localidad].filter(Boolean).join(", ") || "-"}</dd></div>
          {ver === "aprobado" && <div><dt>Aprobó</dt><dd>{c.aprobado_por ?? "-"} · {fecha(c.aprobado)}</dd></div>}
          {ver === "aprobado" && <div><dt>Pedidos</dt><dd>{c.pedidos}</dd></div>}
          {ver === "aprobado" && <div><dt>En Odoo</dt><dd>{c.odoo_pendiente === 2 ? <span class="err">No se pudo: {c.odoo_error} (corregilo en Odoo y tocá «Guardar lista»)</span> : c.odoo_pendiente ? "Pasando a Odoo…" : c.odoo_partner_id ? `Contacto n.º ${c.odoo_partner_id}` : "-"}</dd></div>}
          {c.nota && <div><dt>Nota</dt><dd>{c.nota}</dd></div>}
        </dl>
        {cambios.some((x) => x.cliente_id === c.id) && (
          <details class={c.cambios_sin_ver ? "adm-cambios nuevo" : "adm-cambios"} open={!!c.cambios_sin_ver}>
            <summary>{c.cambios_sin_ver ? "Cambió sus datos (sin revisar)" : "Cambios de datos"}</summary>
            <ul>
              {cambios.filter((x) => x.cliente_id === c.id).slice(0, 20).map((x) => (
                <li>{fecha(x.cuando)} · <b>{CAMPOS[x.campo as keyof typeof CAMPOS] ?? x.campo}</b>: <s>{x.antes ?? "vacío"}</s> → {x.despues ?? "vacío"}</li>
              ))}
            </ul>
            {c.cambios_sin_ver ? (
              <form method="post" action="/api/admin/mayorista">
                <input type="hidden" name="id" value={c.id}><input type="hidden" name="ver" value={ver}>
                <p>En Odoo el contacto no cambia solo: si corresponde, actualizalo ahí.</p>
                <button class="btn lineal chico" name="accion" value="visto">Ya lo revisé</button>
              </form>
            ) : null}
          </details>
        )}
        <form class="adm-acc" method="post" action="/api/admin/mayorista">
          <input type="hidden" name="id" value={c.id}>
          <input type="hidden" name="ver" value={ver}>
          {ver !== "rechazado" && listas.length > 0 && (
            <label class="campo"><span>Lista de precios</span>
              <select name="lista">{listas.map((l) => <option value={l.id_odoo} selected={(c.lista_id ?? porDefecto) === l.id_odoo}>{l.nombre}</option>)}</select>
            </label>
          )}
          <label class="campo"><span>Nota <i>(opcional, solo la ve el equipo)</i></span><input name="nota" maxlength="300" value={c.nota ?? ""}></label>
          <div class="botones">
            {ver === "pendiente" && listas.length > 0 && <button class="btn verde" name="accion" value="aprobar">Aprobar</button>}
            {ver === "pendiente" && <button class="btn lineal" name="accion" value="rechazar">Rechazar</button>}
            {ver === "aprobado" && <button class="btn sec2" name="accion" value="lista">Guardar lista</button>}
            {ver === "aprobado" && <button class="btn lineal" name="accion" value="baja">Dar de baja</button>}
            {ver === "rechazado" && <button class="btn lineal" name="accion" value="reabrir">Volver a pendientes</button>}
          </div>
        </form>
      </article>
    ))}
  </div>
</Base>
