# Umbrales de las alertas de Grafana (ADR 0028). ÚNICO lugar para cambiarlos.
#
# Las reglas (grafana/aprovisionamiento/alerting/reglas-*.yaml) tienen marcas @NOMBRE@ que
# grafana/iniciar.sh reemplaza con estos valores al arrancar Grafana. Para cambiar uno:
#   1. editar el número acá (y commitear: el cambio queda en git);
#   2. lab: make lab-monitoreo   ·   servidor: sudo bash infra/servidor/configurar-monitoreo.sh
#      (o solo reiniciar Grafana: … compose up -d --force-recreate grafana).
# Lo que ya vigilan los scripts del servidor (contenedores, disco > 85 %, RAID, backups,
# pendrive, certificado HTTPS, hora, SMART) NO se repite acá: docs/infraestructura/observabilidad.md.
# Solo números (con punto decimal) o true/false.

# ---------------------------------------------------------------- servidor
# CPU usada (%) durante 15 minutos seguidos
UMBRAL_CPU_PORCENTAJE=90
# RAM disponible (%) por debajo de esto durante 10 minutos
UMBRAL_RAM_DISPONIBLE_PORCENTAJE=10
# Swap usada (%) durante 30 minutos (con 16 GB de RAM casi no debería usarse)
UMBRAL_SWAP_PORCENTAJE=50
# Avisa si, al ritmo de las últimas 12 h, un disco se llena antes de estos días
UMBRAL_DISCO_DIAS_PARA_LLENARSE=7
# Disco ocupado (% del tiempo haciendo lecturas/escrituras) durante 15 minutos
UMBRAL_DISCO_OCUPADO_PORCENTAJE=90
# Temperatura (°C) de cualquier sensor durante 10 minutos (el Ryzen 5600GE llega a 95)
UMBRAL_TEMPERATURA_C=85

# ---------------------------------------------------------------- Odoo
# Segundos que tarda la página de entrada de Odoo, durante 5 minutos
UMBRAL_ODOO_SEGUNDOS=3

# ---------------------------------------------------------------- PostgreSQL
# Conexiones usadas (% del máximo) durante 5 minutos
UMBRAL_PG_CONEXIONES_PORCENTAJE=80
# Una consulta o transacción abierta hace más de estos minutos
UMBRAL_PG_TRANSACCION_MINUTOS=10
# Una conexión «idle in transaction» (empezó y quedó colgada) hace más de estos minutos
UMBRAL_PG_IDLE_TRANSACCION_MINUTOS=5
# Datos leídos de la memoria (%) por debajo de esto durante 30 minutos (con movimiento)
UMBRAL_PG_CACHE_PORCENTAJE=95
# Archivos temporales escritos en una hora (MB): consultas que no entran en memoria
UMBRAL_PG_TEMPORALES_MB_HORA=1024
# Edad de las transacciones (% del límite de PostgreSQL, «wraparound»)
UMBRAL_PG_XID_PORCENTAJE=50
# Tabla de más de estos MB, con muchas filas muertas, sin autovacuum hace más de estos días
UMBRAL_PG_VACUUM_TABLA_MB=50
UMBRAL_PG_VACUUM_FILAS_MUERTAS=10000
UMBRAL_PG_VACUUM_DIAS=7
# La base crece más que esto en 24 h (GB): algo raro (adjuntos repetidos, un error en bucle)
UMBRAL_PG_CRECIMIENTO_GB_DIA=2

# ---------------------------------------------------------------- negocio (ejemplos)
# Dependen del horario del local: revisarlas con Daniel antes de prenderlas.
# «Son más de las 11 (lunes a sábado) y no se imprimió ningún pedido»: apagada (true) hasta
# confirmar el horario; para prenderla, false.
ALERTA_SIN_PEDIDOS_PAUSADA=true
UMBRAL_SIN_PEDIDOS_HORA=11
# Facturas de proveedor en «Se debe pagar: Excepción» al mismo tiempo
UMBRAL_FACTURAS_EXCEPCION=5
# Días sin importar la lista de un proveedor (activa)
UMBRAL_LISTA_DIAS_SIN_IMPORTAR=14
