# Monitoreo del LABORATORIO (ADR 0028). Claves de prueba: el lab es descartable y Grafana
# escucha solo en 127.0.0.1. En el servidor este archivo es /etc/odoo-comercio/monitoreo.env
# (lo crea infra/servidor/configurar-monitoreo.sh con claves nuevas).
MONITOREO_DB=lab
PG_MONITOREO_CLAVE=monitoreo-lab
GRAFANA_DB_CLAVE=grafana-lab
# Usuario «admin» de Grafana en el lab: admin / ejemplo-lab (solo vale la primera vez que
# arranca; después se cambia desde Grafana o con `grafana cli admin reset-admin-password`).
GF_SECURITY_ADMIN_PASSWORD=ejemplo-lab
AVISOS_SERVIDOR=lab
