# Avisos del LABORATORIO (ADR 0028): nada sale a Internet.
# - Discord: el receptor de prueba (compose.monitoreo-lab.yml) guarda lo que recibe.
# - Mail: Mailpit del lab (http://localhost:8025).
# Para probar con un Discord de verdad: MONITOREO_AVISOS_ENV=/ruta/otro.env en el .env del repo.
DISCORD_WEBHOOK_URL=http://receptor-prueba:8080/discord
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=off
SMTP_USUARIO=
SMTP_CLAVE=
MAIL_DE=servidor-lab@example.com
MAIL_PARA=implementador@example.com
