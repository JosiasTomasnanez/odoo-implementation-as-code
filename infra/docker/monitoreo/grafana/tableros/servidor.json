        "uid": "prometheus"
       },
       "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|vfat|ramfs|nsfs|fuse.*\"} / clamp_min(-deriv(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|vfat|ramfs|nsfs|fuse.*\"}[12h]), 0.001) / 86400",
