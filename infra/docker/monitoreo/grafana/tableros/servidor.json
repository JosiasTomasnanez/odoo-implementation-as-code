      "type": "prometheus",
      "uid": "prometheus"
     },
     "targets": [
      {
       "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
       },
       "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
       "refId": "A",
       "legendFormat": "{{mode}}"
      }
     ],
     "fieldConfig": {
      "defaults": {
       "unit": "percent",
       "max": 100,
       "custom": {
        "drawStyle": "line",
        "fillOpacity": 10,
        "lineWidth": 2,
        "showPoints": "never",
        "spanNulls": true,
        "stacking": {
         "mode": "normal"
        }
       }
      },
      "overrides": []
