# Copiar fuera del repo (p. ej. /etc/odoo-comercio/onprem.env) y completar.
COMPOSE_PROJECT_NAME=odoo-prod
# Imagen oficial CON FECHA; Enterprise del mismo día: infra/scripts/fijar-enterprise.sh
ODOO_BASE_IMAGE=odoo:20.0-20261015
# Clon de github.com/odoo/enterprise (acceso de la suscripción, usuario CasaEjemplo)
ODOO_ENTERPRISE_ADDONS=/opt/odoo-enterprise
ODOO_IMAGE=odoo-comercio:local
POSTGRES_VERSION=16
# Archivos con secretos, fuera del repo y con permisos 600:
DB_PASSWORD_FILE=/etc/odoo-comercio/db_password
ODOO_CONF_FILE=/etc/odoo-comercio/odoo.conf

# --- Proxy HTTPS (ADR 0013, docs/runbooks/https-servidor.md) ---
# Nombre con que los puestos entran a Odoo. Debe resolverse en la LAN a la IP del
# servidor (DNS del router o archivo hosts de cada PC). Modo interna: un nombre
# .internal (p. ej. odoo.ejemplo.internal); modo dominio: odoo.<dominio propio>.
ODOO_HOSTS=odoo.comercio-ejemplo.example
# interna = CA propia de Caddy (raíz instalada en cada PC) | dominio = Let's Encrypt DNS-01
CADDY_TLS_MODO=dominio
# IP LAN del servidor donde escucha el proxy (0.0.0.0 = todas).
PROXY_BIND_IP=0.0.0.0
# Certificados y CA interna (con su clave privada): incluir en los backups, permisos 700.
CADDY_DATA_DIR=/var/lib/odoo-comercio/caddy
CADDY_VERSION=2.11.7
# Plugin del proveedor DNS (solo modo dominio); vacío = Caddy sin plugins.
CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare@v0.2.4
# Correo para avisos de Let's Encrypt (solo modo dominio; opcional).
ACME_EMAIL=
# Archivo con el token del DNS, fuera del repo y con permisos 600 (solo modo dominio).
# Contenido: CLOUDFLARE_API_TOKEN=<token con permiso Zone:DNS:Edit solo sobre la zona>
PROXY_SECRETS_FILE=/etc/odoo-comercio/proxy.env

# IA de las listas de proveedores (comercio_catalogo_ia, ADR 0018). Opcional: vacía, el
# botón «Verificar con IA» no aparece. Clave de Google AI Studio a nombre del negocio,
# restringida a la API de Gemini. Este archivo vive fuera del repo con permisos 600.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.8-flash
# Plan gratis de Gemini: 15 pedidos por minuto; se queda en 14. Si se activa el plan pago, poner 0
# (sin tope) y reiniciar Odoo: «Revisar con IA» vuelve a tardar segundos.
GEMINI_PEDIDOS_POR_MINUTO=14

# Monitoreo (ADR 0028): lo pone infra/servidor/configurar-monitoreo.sh (MONITOREO=1). Las
# claves van aparte, en /etc/odoo-comercio/monitoreo.env (600).
# MONITOREO=1

# Acceso desde fuera del local (ADR 0020): lo pone infra/servidor/configurar-acceso-remoto.sh.
# El token del túnel va aparte, en /etc/odoo-comercio/tunel.env (640 root:docker).
# ACCESO_REMOTO=1
# REMOTO_HOST=remoto.comercio-ejemplo.example

# Conector de la tienda online (ADR 0033, compose.tienda.yml). Claves en
# /etc/odoo-comercio/conector-tienda.env (las crea infra/scripts/crear-conector-tienda.sh).
# TIENDA=1
