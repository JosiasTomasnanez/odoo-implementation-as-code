# ADR 0027. Lo instala configurar-respaldo-y-avisos.sh (no editar en /etc/systemd/system).
[Unit]
Description=Chequeo del servidor de Odoo
After=docker.service network-online.target
Wants=network-online.target
OnFailure=odoo-aviso-falla@%n.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/odoo-implementation/infra/servidor/revisar-servidor.sh
