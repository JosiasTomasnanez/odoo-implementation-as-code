<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Facturas pendientes por ARCA caído (solo las cobradas con «Factura» marcado): si ARCA ya responde,
         se facturan con CAE. Sin pendientes no hace nada. -->
    <record id="cron_facturar_pendientes" model="ir.cron">
        <field name="name">Facturas pendientes por ARCA: reintentar</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_comercio_facturar_pendientes()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
