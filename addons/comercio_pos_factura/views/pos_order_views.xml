<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Con y sin factura de Odoo (ADR 0024): filtros y columna en los pedidos del punto de venta -->
    <record id="view_pos_order_filter_factura" model="ir.ui.view">
        <field name="name">pos.order.filter.comercio.factura</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <filter name="invoiced" position="after">
                <filter name="comercio_con_factura_odoo" string="Con factura de Odoo"
                        domain="[('comercio_factura_odoo', '=', True)]"/>
                <filter name="comercio_sin_factura_odoo" string="Sin factura de Odoo (registradora o 3C)"
                        domain="[('comercio_factura_odoo', '=', False), ('state', 'in', ('paid', 'done'))]"/>
            </filter>
            <filter name="order_month" position="after">
                <filter string="Día" name="comercio_dia" domain="[]" context="{'group_by': 'date_order:day'}"/>
                <filter string="Con o sin factura de Odoo" name="comercio_por_factura" domain="[]"
                        context="{'group_by': 'comercio_factura_odoo'}"/>
            </filter>
        </field>
    </record>

    <record id="view_pos_order_tree_factura" model="ir.ui.view">
        <field name="name">pos.order.list.comercio.factura</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <!-- «Crear facturas» de Odoo usa el diario de cada punto de venta (en un puesto, un comprobante
                 sin CAE): en su lugar, «Facturar con CAE» (administración) -->
            <button name="action_create_invoices" position="attributes">
                <attribute name="invisible">True</attribute>
            </button>
            <button name="action_create_invoices" position="after">
                <button name="action_comercio_facturar_con_cae" type="object" string="Facturar con CAE"
                        groups="account.group_account_invoice"
                        confirm="¿Estas ventas NO se hicieron en la registradora? Si se hicieron, quedarían dos comprobantes."/>
            </button>
            <field name="amount_total" position="before">
                <field name="comercio_factura_odoo" optional="show" string="Factura de Odoo"/>
            </field>
        </field>
    </record>

    <!-- Facturar después con CAE (administración): reemplaza al «Factura» de Odoo, que usa el diario del
         punto de venta y en un puesto hace un comprobante interno sin CAE -->
    <record id="view_pos_pos_form_facturar_con_cae" model="ir.ui.view">
        <field name="name">pos.order.form.comercio.facturar.con.cae</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <button name="action_pos_order_invoice" position="attributes">
                <attribute name="invisible">True</attribute>
            </button>
            <button name="action_pos_order_invoice" position="after">
                <field name="comercio_factura_odoo" invisible="1"/>
                <button name="action_comercio_facturar_con_cae" string="Facturar con CAE" type="object"
                        groups="account.group_account_invoice" class="oe_highlight"
                        invisible="state not in ('paid', 'done') or comercio_factura_odoo or amount_total &lt; 0"
                        confirm="¿Esta venta NO se hizo en la registradora? Si se hizo, quedarían dos comprobantes."/>
            </button>
        </field>
    </record>

    <!-- Lo que se cobró sin factura de Odoo, por día y por caja: el «lado registradora» para el contador -->
    <record id="action_ventas_sin_factura_odoo" model="ir.actions.act_window">
        <field name="name">Ventas sin factura de Odoo</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('comercio_factura_odoo', '=', False), ('state', 'in', ('paid', 'done'))]</field>
        <field name="context">{'group_by': ['date_order:day', 'config_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay ventas sin factura de Odoo</p>
            <p>Acá aparece lo que la caja cobró con «Factura» desmarcado: su comprobante lo emite la
                registradora o 3C.</p>
        </field>
    </record>

    <menuitem id="menu_ventas_sin_factura_odoo" name="Ventas sin factura de Odoo"
              parent="point_of_sale.menu_point_of_sale" sequence="5"
              action="action_ventas_sin_factura_odoo"
              groups="point_of_sale.group_pos_manager,account.group_account_invoice"/>
</odoo>
