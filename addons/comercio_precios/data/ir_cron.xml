<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_recalcular_precios" model="ir.cron">
        <field name="name">Precios de venta: recalcular los sugeridos</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_comercio_recalcular_precios()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
