<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El margen del rubro al importar: se carga ahí mismo al crear el rubro (02/11) -->
    <record id="importar_lista_wizard_form_margen" model="ir.ui.view">
        <field name="name">comercio.importar.lista.wizard.form.margen</field>
        <field name="model">comercio.importar.lista.wizard</field>
        <field name="inherit_id" ref="comercio_catalogo.importar_lista_wizard_form"/>
        <field name="arch" type="xml">
            <field name="categoria_id" position="after">
                <field name="margen_rubro" invisible="not categoria_id"/>
                <field name="regla_rubro" invisible="not categoria_id"/>
            </field>
        </field>
    </record>
</odoo>
