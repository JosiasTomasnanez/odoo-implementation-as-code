<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="margen_especial_wizard_form" model="ir.ui.view">
        <field name="name">comercio.margen.especial.wizard.form</field>
        <field name="model">comercio.margen.especial.wizard</field>
        <field name="arch" type="xml">
            <form string="Dar margen especial">
                <group>
                    <field name="producto_ids" widget="many2many_tags"
                           options="{'no_create': True}" placeholder="Nombre, código o código de barras..."/>
                    <field name="rubros" invisible="not producto_ids"/>
                    <field name="margen"/>
                    <field name="base" placeholder="La de su rubro"/>
                    <field name="proveedor_id" invisible="base != 'proveedor'" required="base == 'proveedor'"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_aplicar" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_margen_especial_wizard" model="ir.actions.act_window">
        <field name="name">Dar margen especial</field>
        <field name="res_model">comercio.margen.especial.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
