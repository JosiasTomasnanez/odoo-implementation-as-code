<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cartel_list" model="ir.ui.view">
        <field name="name">comercio.cartel.list</field>
        <field name="model">comercio.cartel</field>
        <field name="arch" type="xml">
            <list decoration-warning="desactualizado" multi_edit="1">
                <header>
                    <button name="action_imprimir" type="object" string="Imprimir" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="aclaracion" optional="show"/>
                <field name="product_tmpl_id" optional="hide"/>
                <field name="precio" widget="monetary" options="{'currency_field': False}"/>
                <field name="precio_impreso" optional="show" invisible="not fecha_impreso"/>
                <field name="desactualizado" optional="show" widget="boolean_toggle" readonly="1"/>
                <field name="formato"/>
                <field name="estilo"/>
                <field name="copias"/>
                <field name="fecha_impreso" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cartel_form" model="ir.ui.view">
        <field name="name">comercio.cartel.form</field>
        <field name="model">comercio.cartel</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_imprimir" type="object" string="Imprimir" class="btn-primary"/>
                    <button name="action_ver_pdf" type="object" string="Ver PDF"
                            help="El PDF como va a salir, para revisarlo (no cuenta como impreso)."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Para reimprimir" bg_color="text-bg-warning" invisible="not desactualizado"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Lo que dice el cartel en grande" widget="text"/></h1>
                    </div>
                    <group>
                        <group string="Precio">
                            <field name="product_tmpl_id" placeholder="Vacío: cartel suelto con precio a mano"/>
                            <field name="modo_precio" widget="radio" invisible="not product_tmpl_id"/>
                            <field name="precio_odoo" invisible="not product_tmpl_id"/>
                            <field name="redondeo" invisible="not product_tmpl_id or modo_precio == 'manual'"/>
                            <field name="precio_manual" invisible="product_tmpl_id and modo_precio == 'odoo'"/>
                            <field name="precio" class="fw-bold"/>
                            <field name="aclaracion" placeholder="x kg, c/u, la bolsa de 25 kg"/>
                            <field name="precio_antes"/>
                        </group>
                        <group string="Cómo se imprime">
                            <field name="formato" widget="radio"/>
                            <field name="estilo" widget="radio" options="{'horizontal': true}"/>
                            <field name="copias"/>
                            <field name="mostrar_codigo_barras" invisible="not product_tmpl_id"/>
                            <field name="precio_impreso" invisible="not fecha_impreso"/>
                            <field name="fecha_impreso" invisible="not fecha_impreso"/>
                            <field name="desactualizado" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Vista previa (se actualiza mientras editás)"/>
                    <div class="text-center py-3 bg-200 rounded overflow-auto">
                        <field name="vista_previa" nolabel="1" readonly="1" class="d-inline-block w-auto mw-100"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cartel_search" model="ir.ui.view">
        <field name="name">comercio.cartel.search</field>
        <field name="model">comercio.cartel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <filter name="desactualizado" string="Para reimprimir" domain="[('desactualizado', '=', True)]"/>
                <filter name="sin_imprimir" string="Sin imprimir" domain="[('fecha_impreso', '=', False)]"/>
                <separator/>
                <filter name="oferta" string="Ofertas" domain="[('estilo', '=', 'oferta')]"/>
                <filter name="archivados" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_carteles" model="ir.actions.act_window">
        <field name="name">Carteles</field>
        <field name="res_model">comercio.cartel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hacé el primer cartel</p>
            <p>Desde Productos: marcá los que querés y Acciones → «Hacer carteles». O uno suelto con «Nuevo».</p>
        </field>
    </record>

    <record id="action_carteles_reimprimir" model="ir.actions.act_window">
        <field name="name">Carteles para reimprimir</field>
        <field name="res_model">comercio.cartel</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_desactualizado': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todos los carteles impresos tienen el precio de hoy</p>
        </field>
    </record>

    <!-- Productos → Acciones → «Hacer carteles» -->
    <record id="accion_hacer_carteles" model="ir.actions.server">
        <field name="name">Hacer carteles</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_comercio_hacer_carteles()</field>
    </record>

    <menuitem id="menu_carteles_raiz" name="Carteles" sequence="35" web_icon="comercio_carteles,static/description/icon.png"/>
    <menuitem id="menu_carteles" name="Carteles" parent="menu_carteles_raiz" action="action_carteles" sequence="1"/>
    <menuitem id="menu_carteles_reimprimir" name="Para reimprimir" parent="menu_carteles_raiz"
              action="action_carteles_reimprimir" sequence="2"/>
</odoo>
