<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="costo_de_wizard_form" model="ir.ui.view">
        <field name="name">comercio.costo.de.wizard.form</field>
        <field name="model">comercio.costo.de.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="proveedores_ids" invisible="1"/>
                    <field name="modo" widget="radio"/>
                    <field name="proveedor_id" invisible="modo != 'proveedor'" required="modo == 'proveedor'"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <p class="text-muted"><field name="resumen" readonly="1"/></p>
                <p class="text-muted">El costo sigue calculándose solo con cada lista, pero de ese proveedor (si deja
                    de tener precio vigente, vuelve al más barato).</p>
                <footer>
                    <button name="action_aplicar" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- En el menú Acciones de Productos, junto a «Fusionar» -->
    <record id="action_costo_de" model="ir.actions.server">
        <field name="name">Tomar el costo de…</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('comercio_catalogo.group_listas_proveedores'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['comercio.costo.de.wizard'].abrir(records)</field>
    </record>
</odoo>
