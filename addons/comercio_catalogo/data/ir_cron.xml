<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_actualizar_listas" model="ir.cron">
        <field name="name">Listas de proveedores: actualización automática</field>
        <field name="model_id" ref="model_comercio_lista_proveedor"/>
        <field name="state">code</field>
        <field name="code">model._cron_actualizar_listas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="cron_aplicar_en_cola" model="ir.cron">
        <field name="name">Listas de proveedores: aplicar en segundo plano</field>
        <field name="model_id" ref="model_comercio_lista_importacion"/>
        <field name="state">code</field>
        <field name="code">model._cron_aplicar_en_cola()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_actualizar_costos" model="ir.cron">
        <field name="name">Listas de proveedores: costo de los productos (precios que empiezan o vencen)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_comercio_actualizar_costos()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="cron_recalcular_dolar" model="ir.cron">
        <field name="name">Listas de proveedores: recalcular las listas en dólares con el dólar del día</field>
        <field name="model_id" ref="model_comercio_lista_proveedor"/>
        <field name="state">code</field>
        <field name="code">model._cron_recalcular_dolar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Después de la cotización del día (tarea de Odoo «Monedas: actualizar cotizaciones») -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
